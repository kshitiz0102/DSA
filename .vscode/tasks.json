{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile C++",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run with input.txt",
            "type": "shell",
            "command": "Get-Content .\\input.txt | & .\\${fileBasenameNoExtension}.exe | Out-File -Encoding utf8 .\\output.txt",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": []
        },
        {
            "label": "Compile and Run",
            "dependsOn": [
                "Compile C++",
                "Run with input.txt"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}